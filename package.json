{
  "name": "als-front-gestionticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:lint": "redocly lint openapi/openapi.yaml",
    "api:types": "openapi-typescript openapi/openapi.yaml -o src/api/schema.d.ts",
    "api:docs": "redocly build-docs openapi/openapi.yaml -o docs/api/index.html",
    "mock:prism": "prism mock openapi/openapi.yaml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:check-types": "npm run api:types && git diff --exit-code -- src/api/schema.d.ts",
    "check": "npm run api:lint && npm run typecheck && npm test",
    "mock:server": "tsx src/mocks/http-server.ts",
    "postman:build": "tsx scripts/build-postman.ts",
    "docs:diagrams": "tsx scripts/render-diagrams.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@redocly/cli": "^2.62.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "swagger-ui-dist": "^5.33.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=22.12"
  }
}
